# Copy to apps/server/.env.test. Used by `npm test` instead of .env so tests never touch real data.
# Start the database: docker compose -f docker-compose.test.yml up -d --wait
# Then apply migrations as the owner:  npm run test:db:migrate -w server
DATABASE_URL="postgresql://app_user:app_user@localhost:5433/resolvex_test"
JWT_ACCESS_SECRET="test-access-secret-0123456789abcdef0123456789"
JWT_REFRESH_SECRET="test-refresh-secret-0123456789abcdef0123456789"
