# Copy this file to `.env` and replace the placeholders with real values.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://neondb_owner:npg_AlKzxj5sd6ZS@ep-shiny-rice-b5w9y7i2-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Required: random strings, >= 32 chars each (e.g. openssl rand -base64 48).
JWT_ACCESS_SECRET="zm97Iu1jGhA3jN8qFVwMEqiwtGZT3zSIvurkWlW6hjs"
JWT_REFRESH_SECRET="LbLsiVLa2iWi92Kamf2H3oRIGYwEypBtGPA2g40GQ7T"

# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS="http://localhost:3001"

# Google OAuth 2.0 Credentials (optional in dev, required for Google One Tap / SSO)
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Set when behind a reverse proxy (e.g. Traefik): "true" or a hop count.
# TRUST_PROXY=true

# Rate limiting keys on the client IP. Behind a proxy (Next rewrite, Traefik) you MUST set TRUST_PROXY
# so the real client IP is used; otherwise every user shares the proxy's IP and its limit.

# Nodemailer SMTP Configuration for OTP Verification
# If omitted in local development, OTP codes are printed to the server console for easy testing.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
# Set SMTP_USER and SMTP_PASS to enable OTP email delivery.
# For Gmail: use your email address and an App Password (https://support.google.com/mail/answer/180557)
# Set AUTH_REQUIRE_OTP=false to disable OTP during login (OTP will only be used during registration if needed)
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="ResolveX <noreply@resolvex.ai>"
AUTH_REQUIRE_OTP="false"

# ---------------------------------------------------------------------------
# Platform settings added with the monitoring / incident / integrations modules
# ---------------------------------------------------------------------------

APP_URL="http://localhost:3001"
PUBLIC_API_URL="http://localhost:3001"

# AES-256-GCM key material (>= 32 chars) for secrets stored in the database: monitor auth headers,
# outgoing-webhook signing secrets, GitHub tokens/webhook secrets. Set it in production; without it a key
# is derived from JWT_REFRESH_SECRET, and rotating that secret would make stored secrets unreadable.
SECRETS_ENCRYPTION_KEY="replace-with-another-long-random-secret"

# --- Monitoring (worker) ---
# Monitors may only target public addresses. Self-hosted installs that monitor internal services can opt in:
# ALLOW_PRIVATE_NETWORK_TARGETS=false
# Ports monitors/webhooks may call ("*" = any). Default: 80,443,8080,8443,3000,5000,8000,9000
# OUTBOUND_ALLOWED_PORTS="80,443,8080,8443,3000,5000,8000,9000"
# MONITOR_CONCURRENCY=10           # checks run in parallel per worker tick
# MONITOR_RETENTION_DAYS=30        # raw check history kept
# WORKER_HEALTH_PORT=3010          # optional liveness endpoint for the worker process

# --- Uploads ---
# MAX_ATTACHMENT_BYTES=2097152     # per task attachment (stored in PostgreSQL)
# UPLOAD_BODY_LIMIT=4mb            # request body cap for attachment/avatar routes only

# --- Escalation notification relays (optional) ---
# NOTIFICATION_EMAIL_WEBHOOK_URL=  # send escalation emails through an HTTP relay instead of SMTP
# NOTIFICATION_SMS_WEBHOOK_URL=    # HTTP relay for the "sms" escalation channel
# NOTIFICATION_REQUEST_TIMEOUT_MS=5000

# --- GitHub integration (optional) ---
# Create an OAuth App: callback URL = $PUBLIC_API_URL/api/integrations/github/callback
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# --- AI incident assistant (optional; without it a rule-based analyzer is used) ---
# AI_PROVIDER=anthropic|openai|ollama
# AI_API_KEY=""
# AI_MODEL=""                      # e.g. claude-sonnet-5-5, gpt-4o-mini, llama3.1, gpt-4o
# AI_BASE_URL=""                   # required for ollama (e.g. http://ollama:11434); optional OpenAI-compatible base
# AI_TIMEOUT_MS=45000

# --- Logging ---
# LOG_LEVEL=info                   # debug | info | warn | error
# LOG_FORMAT=json                  # json (default) | pretty