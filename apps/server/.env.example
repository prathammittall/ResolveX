# Copy this file to `.env` and replace the placeholders with real values.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# POST /api/webhooks/alerts authenticates with a per-service key, not an environment secret.
# Create one (owner/admin) with: POST /api/services/:id/webhook-keys  {"name": "datadog"}
# The token (rxwh_...) is shown once; only its hash is stored. Send: Authorization: Bearer <token>
# Revoke with: DELETE /api/services/:id/webhook-keys/:keyId

# Required: random strings, >= 32 chars each (e.g. openssl rand -base64 48).
# The server refuses to start without them.
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"

# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS="http://localhost:3001"
# Optional generic outbound notification adapters. They must accept POST JSON requests.
NOTIFICATION_EMAIL_WEBHOOK_URL=""
NOTIFICATION_SMS_WEBHOOK_URL=""
NOTIFICATION_REQUEST_TIMEOUT_MS="5000"

# SMTP email delivery. If omitted, email notifications are recorded as failed.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ResolveX <no-reply@example.com>"
# MAIL_FROM is also accepted for compatibility.
APP_BASE_URL="http://localhost:3001"
# Set when behind a reverse proxy (e.g. Traefik): "true" or a hop count.
# TRUST_PROXY=true

# Rate limiting keys on the client IP. Behind a proxy (Next rewrite, Traefik) you MUST set TRUST_PROXY
# so the real client IP is used; otherwise every user shares the proxy's IP and its limit.
