# Copy this file to `.env` in apps/server/ and configure your secrets.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/resolvex"

# Required: random strings >= 32 chars (e.g. openssl rand -base64 48)
JWT_ACCESS_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string-at-least-32-chars"
SECRETS_ENCRYPTION_KEY="change-me-to-a-third-long-random-string-at-least-32-chars"

# Browser frontend origin allowed to call the API
CORS_ORIGINS="http://localhost:3001"
APP_URL="http://localhost:3001"
PUBLIC_API_URL="http://localhost:3001"

# Google OAuth 2.0 Credentials (optional in dev)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ---------------------------------------------------------------------------
# Nodemailer SMTP Configuration (Forgot Password, OTP, & System Alerts)
# ---------------------------------------------------------------------------
# When not set or when using placeholder defaults, OTP codes and password reset links
# are logged directly to the server terminal console for frictionless local testing.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
# For Gmail: use your full Gmail address and an App Password (https://support.google.com/mail/answer/180557)
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="ResolveX <noreply@resolvex.ai>"
AUTH_REQUIRE_OTP="false"
