# Copy this file to `.env` and replace the placeholders with real values.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Shared secret for POST /api/webhooks/alerts (v1 auth boundary).
# Send either:
#   Authorization: Bearer <ALERT_WEBHOOK_SECRET>
#   X-Webhook-Signature: sha256=<hmac-sha256-hex of raw body>
# Never commit real secrets. Do not store this value in the database in plaintext.
ALERT_WEBHOOK_SECRET="replace-with-a-long-random-secret"
