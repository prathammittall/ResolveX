// use prisma-8

// --- Enums ---

enum UserRole {
  @@type("pg/text@1")
  owner     = "owner"
  admin     = "admin"
  responder = "responder"
  member    = "member"
  viewer    = "viewer"
}

enum ServiceType {
  @@type("pg/text@1")
  http      = "http"
  api       = "api"
  database  = "database"
  queue     = "queue"
  worker    = "worker"
  other     = "other"
}

enum ServiceEnvironment {
  @@type("pg/text@1")
  production  = "production"
  staging     = "staging"
  development = "development"
}

enum ServiceCriticality {
  @@type("pg/text@1")
  low      = "low"
  medium   = "medium"
  high     = "high"
  critical = "critical"
}

enum ServiceHealthStatus {
  @@type("pg/text@1")
  healthy  = "healthy"
  degraded = "degraded"
  down     = "down"
  unknown  = "unknown"
}

enum IncidentSeverity {
  @@type("pg/text@1")
  sev1 = "sev1"
  sev2 = "sev2"
  sev3 = "sev3"
  sev4 = "sev4"
}

enum IncidentStatus {
  @@type("pg/text@1")
  open          = "open"
  acknowledged  = "acknowledged"
  investigating = "investigating"
  mitigated     = "mitigated"
  resolved      = "resolved"
}

enum IncidentEventType {
  @@type("pg/text@1")
  created       = "created"
  acknowledged  = "acknowledged"
  status_change = "status_change"
  comment       = "comment"
  assignment    = "assignment"
  resolved      = "resolved"
  system        = "system"
}

enum AlertProcessingStatus {
  @@type("pg/text@1")
  pending    = "pending"
  processed  = "processed"
  ignored    = "ignored"
  failed     = "failed"
}

enum EscalationTargetType {
  @@type("pg/text@1")
  user    = "user"
  team    = "team"
  webhook = "webhook"
}

enum EscalationStatus {
  @@type("pg/text@1")
  active       = "active"
  acknowledged = "acknowledged"
  exhausted    = "exhausted"
  cancelled    = "cancelled"
}

enum QueueJobType {
  @@type("pg/text@1")
  escalate = "escalate"
  notify   = "notify"
}

enum QueueJobStatus {
  @@type("pg/text@1")
  pending    = "pending"
  processing = "processing"
  completed  = "completed"
  failed     = "failed"
  cancelled  = "cancelled"
}

enum NotificationDeliveryStatus {
  @@type("pg/text@1")
  pending   = "pending"
  sent      = "sent"
  delivered = "delivered"
  failed    = "failed"
  cancelled = "cancelled"
}

enum TaskType {
  @@type("pg/text@1")
  epic    = "epic"
  story   = "story"
  task    = "task"
  bug     = "bug"
  subtask = "subtask"
}

enum TaskPriority {
  @@type("pg/text@1")
  lowest  = "lowest"
  low     = "low"
  medium  = "medium"
  high    = "high"
  highest = "highest"
}

enum StatusCategory {
  @@type("pg/text@1")
  todo        = "todo"
  in_progress = "in_progress"
  done        = "done"
}

// --- Models ---

model Company {
  id        Int        @id @default(autoincrement())
  name      String
  users     User[]
  services  Service[]
  webhookKeys WebhookKey[]
  organization Organization?
  incidents Incident[]
  escalationPolicies EscalationPolicy[]
  maintenanceWindows MaintenanceWindow[]
  queueJobs QueueJob[]
  notificationDeliveries NotificationDelivery[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([name])
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  username     String?
  name         String?
  passwordHash String?
  refreshToken String?
  role         UserRole  @default(member)
  companyId Int
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  posts     Post[]
  sessions  Session[]
  memberships Membership[]
  teamMemberships TeamMember[]
  assignedTasks Task[] @relation("TaskAssignee")
  reportedTasks Task[] @relation("TaskReporter")
  taskComments TaskComment[]
  assignedIncidents Incident[]     @relation("IncidentAssignee")
  incidentEvents    IncidentEvent[] @relation("IncidentEventActor")
  createdMaintenanceWindows MaintenanceWindow[] @relation("MaintenanceWindowCreator")
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([companyId])
  @@index([companyId, role])
}

// One row per issued refresh token. Only the SHA-256 hash of the token is stored.
// All tokens descending from one login share a familyId; presenting an already-used
// token revokes the whole family (refresh-token reuse detection).
model Session {
  id          Int               @id @default(autoincrement())
  userId      Int
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId    String
  tokenHash   String            @unique
  expiresAt   TimestamptzString
  revokedAt   TimestamptzString?
  createdAt   TimestamptzString @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

// Per-service credential for POST /api/webhooks/alerts. Only the SHA-256 hash of the token is stored
// (the token is high-entropy random, so a fast hash is appropriate). A key authorises alerts for
// exactly one service, so a leaked key cannot touch other services or tenants.
model WebhookKey {
  id          Int                @id @default(autoincrement())
  companyId   Int
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceId   Int
  service     Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name        String
  keyPrefix   String
  keyHash     String             @unique
  createdById Int?
  lastUsedAt  TimestamptzString?
  revokedAt   TimestamptzString?
  createdAt   TimestamptzString  @default(now())

  @@index([companyId])
  @@index([serviceId])
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([authorId])
}

model Service {
  id            Int                  @id @default(autoincrement())
  companyId     Int
  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  serviceType   ServiceType
  monitoredUrl  String?
  environment   ServiceEnvironment
  criticality   ServiceCriticality
  healthStatus  ServiceHealthStatus  @default(unknown)
  incidents     Incident[]
  alertEvents   AlertEvent[]
  webhookKeys   WebhookKey[]
  escalationPolicies EscalationPolicy[] @relation("ServiceEscalationPolicies")
  maintenanceWindows MaintenanceWindow[]
  createdAt     TimestamptzString    @default(now())
  updatedAt     temporal.updatedAtString()

  @@unique([companyId, name])
  @@index([companyId])
  @@index([companyId, healthStatus])
  @@index([companyId, environment])
}

model Incident {
  id                  Int              @id @default(autoincrement())
  companyId           Int
  company             Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceId           Int
  service             Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  title               String
  description         String?
  severity            IncidentSeverity
  status              IncidentStatus   @default(open)
  assignedResponderId Int?
  assignedResponder   User?            @relation("IncidentAssignee", fields: [assignedResponderId], references: [id], onDelete: SetNull)
  detectedAt          TimestamptzString
  acknowledgedAt      TimestamptzString?
  firstAcknowledgedAt TimestamptzString?
  acknowledgmentDueAt TimestamptzString?
  mttaSeconds         Int?
  escalationStatus    EscalationStatus?
  escalationPolicyId  Int?
  escalationPolicy    EscalationPolicy? @relation(fields: [escalationPolicyId], references: [id], onDelete: SetNull)
  resolvedAt          TimestamptzString?
  events              IncidentEvent[]
  alertEvents         AlertEvent[]
  escalation           IncidentEscalation?
  queueJobs           QueueJob[]
  notificationDeliveries NotificationDelivery[]
  createdAt           TimestamptzString @default(now())
  updatedAt           temporal.updatedAtString()

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, severity])
  @@index([serviceId])
  @@index([assignedResponderId])
  @@index([escalationPolicyId])
  // At most one unresolved incident per service (grouping key for v1).
  @@index([serviceId], where: sql`(status <> 'resolved')`, unique: true, name: "incident_one_unresolved_per_service")
}

model IncidentEvent {
  id         Int               @id @default(autoincrement())
  incidentId Int
  incident   Incident          @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actorId    Int?
  actor      User?             @relation("IncidentEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  eventType  IncidentEventType
  message    String
  occurredAt TimestamptzString @default(now())

  @@index([incidentId])
  @@index([incidentId, occurredAt])
  @@index([actorId])
}

model AlertEvent {
  id               Int                   @id @default(autoincrement())
  serviceId        Int
  service          Service               @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  incidentId       Int?
  incident         Incident?             @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  provider         String
  providerEventId  String
  payload          Jsonb
  processingStatus AlertProcessingStatus @default(pending)
  receivedAt       TimestamptzString     @default(now())

  // Same provider event must not be ingested twice for one service.
  @@unique([serviceId, provider, providerEventId])
  @@index([serviceId])
  @@index([incidentId])
  @@index([processingStatus])
  @@index([receivedAt])
}

model EscalationPolicy {
  id          Int      @id @default(autoincrement())
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceId   Int?
  service     Service? @relation("ServiceEscalationPolicies", fields: [serviceId], references: [id], onDelete: Cascade)
  name        String
  enabled     Boolean  @default(true)
  steps       EscalationStep[]
  incidents   Incident[]
  escalations IncidentEscalation[]
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  @@unique([companyId, name])
  @@index([companyId, enabled])
  @@index([serviceId, enabled])
}

model EscalationStep {
  id                 Int                  @id @default(autoincrement())
  policyId           Int
  policy             EscalationPolicy     @relation(fields: [policyId], references: [id], onDelete: Cascade)
  position           Int
  delaySeconds       Int
  targetType         EscalationTargetType
  targetId           String
  notificationChannels Jsonb
  acknowledgmentRequired Boolean          @default(true)
  createdAt          TimestamptzString    @default(now())

  @@unique([policyId, position])
  @@index([policyId])
}

model MaintenanceWindow {
  id                  Int      @id @default(autoincrement())
  companyId           Int
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceId           Int?
  service             Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name                String
  startsAt            TimestamptzString
  endsAt              TimestamptzString
  timezone            String
  enabled             Boolean  @default(true)
  bypassSeverity     IncidentSeverity?
  createdById         Int?
  createdBy           User?    @relation("MaintenanceWindowCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt           TimestamptzString @default(now())
  updatedAt           temporal.updatedAtString()

  @@index([companyId, startsAt, endsAt])
  @@index([serviceId, startsAt, endsAt])
}

model IncidentEscalation {
  id              Int              @id @default(autoincrement())
  incidentId      Int              @unique
  incident        Incident          @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  policyId        Int
  policy          EscalationPolicy  @relation(fields: [policyId], references: [id], onDelete: Restrict)
  currentStep     Int               @default(0)
  status          EscalationStatus  @default(active)
  acknowledgedAt  TimestamptzString?
  nextEscalationAt TimestamptzString?
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()

  @@index([policyId])
  @@index([status, nextEscalationAt])
}

model QueueJob {
  id             Int           @id @default(autoincrement())
  companyId      Int
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  incidentId     Int?
  incident       Incident?     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  type           QueueJobType
  status         QueueJobStatus @default(pending)
  runAt          TimestamptzString
  attempts       Int            @default(0)
  lockedUntil    TimestamptzString?
  idempotencyKey String         @unique
  payload        Jsonb
  lastError      String?
  deliveries     NotificationDelivery[]
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@index([status, runAt])
  @@index([companyId, status, runAt])
  @@index([incidentId])
}

model NotificationDelivery {
  id             Int                        @id @default(autoincrement())
  companyId      Int
  company        Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  incidentId     Int
  incident       Incident                   @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  queueJobId     Int?
  queueJob       QueueJob?                  @relation(fields: [queueJobId], references: [id], onDelete: SetNull)
  channel        String
  recipient      String
  status         NotificationDeliveryStatus @default(pending)
  sentAt         TimestamptzString?
  deliveredAt    TimestamptzString?
  acknowledgedAt TimestamptzString?
  error          String?
  idempotencyKey String                     @unique
  createdAt      TimestamptzString          @default(now())
  updatedAt      temporal.updatedAtString()

  @@index([companyId, incidentId])
  @@index([incidentId, status])
  @@index([queueJobId])
}

// --- Tenancy (Phase 4). New tables use UUID primary keys. ---
// `Organization` supersedes `Company`; `companyId` is the bridge while legacy tables (Service, Incident, ...)
// still carry an integer companyId. Role now lives on `Membership`, not on `User`.

model Organization {
  id          Uuid              @id @default(uuid())
  name        String
  slug        String            @unique
  companyId   Int?              @unique
  company     Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  memberships Membership[]
  invitations Invitation[]
  teams       Team[]
  teamMembers TeamMember[]
  auditLogs   AuditLog[]
  projects    Project[]
  projectStatuses ProjectStatus[]
  tasks       Task[]
  taskComments TaskComment[]
  taskActivities TaskActivity[]
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
  @@rls
}

model Membership {
  id             Uuid              @id @default(uuid())
  organizationId Uuid  
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         Int
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           UserRole          @default(member)
  createdAt      TimestamptzString @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
  @@rls
}

model Invitation {
  id             String             @id @default(uuid())
  organizationId Uuid  
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           UserRole           @default(member)
  tokenHash      String             @unique
  invitedById    Int?
  expiresAt      TimestamptzString
  acceptedAt     TimestamptzString?
  revokedAt      TimestamptzString?
  createdAt      TimestamptzString  @default(now())

  @@index([organizationId])
  @@index([email])
  // One pending invitation per email per organization.
  @@index([organizationId, email], where: sql`("acceptedAt" IS NULL AND "revokedAt" IS NULL)`, unique: true, name: "invitation_one_pending_per_email")
  @@rls
}

model Team {
  id             Uuid              @id @default(uuid())
  organizationId Uuid  
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  members        TeamMember[]
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@unique([organizationId, name])
  @@rls
}

model TeamMember {
  id             Uuid              @id @default(uuid())
  // Denormalised so row-level security can filter this table without a join.
  organizationId Uuid  
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamId         Uuid  
  team           Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId         Int
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  isLead         Boolean           @default(false)
  createdAt      TimestamptzString @default(now())

  @@unique([teamId, userId])
  @@index([organizationId])
  @@index([userId])
  @@rls
}

model AuditLog {
  id             Uuid              @id @default(uuid())
  organizationId Uuid  
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        Int?
  action         String
  entityType     String
  entityId       String?
  metadata       Jsonb?
  requestId      String?
  createdAt      TimestamptzString @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@rls
}

// --- Project management (Phase 5). UUID keys, tenant-scoped, RLS-protected. ---

model Project {
  id             Uuid               @id @default(uuid())
  organizationId Uuid
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Short uppercase prefix used in ticket ids, e.g. PAY -> PAY-12.
  key            String
  name           String
  description    String?
  // Next ticket number; incremented under a row lock so numbers are unique and gap-free per project.
  nextTaskNumber Int                @default(1)
  createdById    Int?
  archivedAt     TimestamptzString?
  statuses       ProjectStatus[]
  tasks          Task[]
  createdAt      TimestamptzString  @default(now())
  updatedAt      temporal.updatedAtString()

  @@unique([organizationId, key])
  @@index([organizationId])
  @@rls
}

// Configurable workflow: each project owns an ordered list of statuses mapped to a category.
model ProjectStatus {
  id             Uuid              @id @default(uuid())
  organizationId Uuid
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      Uuid
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  category       StatusCategory
  position       Int
  tasks          Task[]
  createdAt      TimestamptzString @default(now())

  @@unique([projectId, name])
  @@index([projectId, position])
  @@index([organizationId])
  @@rls
}

model Task {
  id             Uuid               @id @default(uuid())
  organizationId Uuid
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      Uuid
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number         Int
  type           TaskType           @default(task)
  title          String
  description    String?
  statusId       Uuid
  status         ProjectStatus      @relation(fields: [statusId], references: [id], onDelete: Restrict)
  priority       TaskPriority       @default(medium)
  assigneeId     Int?
  assignee       User?              @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporterId     Int?
  reporter       User?              @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  // Epic for stories/tasks, or parent task for subtasks. Validated in code (same project, sensible type).
  parentId       Uuid?
  dueDate        TimestamptzString?
  labels         Jsonb
  comments       TaskComment[]
  activities     TaskActivity[]
  createdAt      TimestamptzString  @default(now())
  updatedAt      temporal.updatedAtString()

  @@unique([projectId, number])
  @@index([projectId, statusId])
  @@index([organizationId, assigneeId])
  @@index([parentId])
  @@rls
}

model TaskComment {
  id             Uuid              @id @default(uuid())
  organizationId Uuid
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taskId         Uuid
  task           Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId       Int?
  author         User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body           String
  createdAt      TimestamptzString @default(now())

  @@index([taskId, createdAt])
  @@index([organizationId])
  @@rls
}

// Per-task history shown on the ticket (visible to everyone who can see the task, unlike AuditLog).
model TaskActivity {
  id             Uuid              @id @default(uuid())
  organizationId Uuid
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taskId         Uuid
  task           Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId        Int?
  type           String
  data           Jsonb?
  createdAt      TimestamptzString @default(now())

  @@index([taskId, createdAt])
  @@index([organizationId])
  @@rls
}

// --- Row-level security: every row is visible only inside the organization set by `withTenant`. ---
// `app.org_id` is a transaction-local setting; unset => no rows (fail closed).
// `app.user_id` lets a signed-in user list their own memberships/organizations before choosing one.

policy_all organization_isolation {
  target    = Organization
  using     = sql`"id" = NULLIF(current_setting('app.org_id', true), '')::uuid`
  withCheck = sql`"id" = NULLIF(current_setting('app.org_id', true), '')::uuid`
}

policy_select organization_member_read {
  target = Organization
  using  = sql`EXISTS (SELECT 1 FROM "Membership" m WHERE m."organizationId" = "Organization"."id" AND m."userId" = NULLIF(current_setting('app.user_id', true), '')::int)`
}

policy_all membership_isolation {
  target    = Membership
  using     = sql`"organizationId" = NULLIF(current_setting('app.org_id', true), '')::uuid`
  withCheck = sql`"organizationId" = NULLIF(current_setting('app.org_id', true), '')::uuid`
}

policy_select membership_self_read {
  target = Membership
  using  = sql`"userId" = NULLIF(current_setting('app.user_id', true), '')::int`
}

policy_all invitation_isolation {
  target    = Invitation
  using     = sql`"organizationId" = NULLIF(current_setting('app.org_id', true), '')::uuid`
  withCheck = sql`"organizationId" = NULLIF(current_setting('app.org_id', true), '')::uuid`
}

// Accepting an invitation happens before the user belongs to the organization, so the invitation is
// located by the SHA-256 hash of its secret token (`app.invite_hash`) instead of by organization.
policy_select invitation_by_token {
  target = Invitation
  using  = sql`"tokenHash" = NULLIF(current_setting('app.invite_hash', true), '')`
}

policy_all team_isolation {
  target    = Team
  using     = sql`"organizationId" = NULLIF(current_setting('app.org_id', true), '')::uuid`
  withCheck = sql`"organizationId" = NULLIF(current_setting('app.org_id', true), '')::uuid`
}

policy_all team_member_isolation {
  target    = TeamMember
  using     = sql`"organizationId" = NULLIF(current_setting('app.org_id', true), '')::uuid`
  withCheck = sql`"organizationId" = NULLIF(current_setting('app.org_id', true), '')::uuid`
}

policy_all audit_log_isolation {
  target    = AuditLog
  using     = sql`"organizationId" = NULLIF(current_setting('app.org_id', true), '')::uuid`
  withCheck = sql`"organizationId" = NULLIF(current_setting('app.org_id', true), '')::uuid`
}

policy_all project_isolation {
  target    = Project
  using     = sql`"organizationId" = NULLIF(current_setting('app.org_id', true), '')::uuid`
  withCheck = sql`"organizationId" = NULLIF(current_setting('app.org_id', true), '')::uuid`
}

policy_all project_status_isolation {
  target    = ProjectStatus
  using     = sql`"organizationId" = NULLIF(current_setting('app.org_id', true), '')::uuid`
  withCheck = sql`"organizationId" = NULLIF(current_setting('app.org_id', true), '')::uuid`
}

policy_all task_isolation {
  target    = Task
  using     = sql`"organizationId" = NULLIF(current_setting('app.org_id', true), '')::uuid`
  withCheck = sql`"organizationId" = NULLIF(current_setting('app.org_id', true), '')::uuid`
}

policy_all task_comment_isolation {
  target    = TaskComment
  using     = sql`"organizationId" = NULLIF(current_setting('app.org_id', true), '')::uuid`
