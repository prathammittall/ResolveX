# Copy to `.env` next to docker-compose.yml. Generate secrets with: openssl rand -base64 48
POSTGRES_DB=resolvex
POSTGRES_USER=resolvex
POSTGRES_PASSWORD=change-me
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
SECRETS_ENCRYPTION_KEY=change-me-to-a-third-long-random-string
CORS_ORIGINS=http://localhost:3001
APP_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:3001
# Optional
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
ALLOW_PRIVATE_NETWORK_TARGETS=false
